{
  "name": "@oh-agent/dsh-mcp-manager",
  "version": "0.1.0",
  "description": "One settings page for every MCP server on your machine: scan each AI tool's own config file, see which directory holds which server, probe whether it really starts, and mount or unmount it in DeepSeek Harness without ever editing the other tools' files. / 一个设置页管理本机所有 AI 开发工具的 MCP：按配置文件分组展示、真连探活、只在 DeepSeek Harness 内挂载/卸载，绝不改动其他工具的配置。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "mcp-manager",
    "claude-code",
    "cursor",
    "vscode",
    "opencode",
    "trae",
    "qoder",
    "gemini-cli",
    "zed",
    "config"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangbobo-coder/dsh-mcp-manager.git"
  },
  "homepage": "https://github.com/wangbobo-coder/dsh-mcp-manager#readme",
  "bugs": {
    "url": "https://github.com/wangbobo-coder/dsh-mcp-manager/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
